{"text": "RAG 是两条流水线。一条是离线的，只做一次：把文档切成块，把每一块变成一个向量，存进索引。另一条是每个问题都要走的：把问题变成向量，取回离它最近的块，用重排模型把最好的几块重新排序，编好号放进提示，让模型带着引用作答。每个环节下面写着这一步可以调的东西。", "lang": "zh", "voice": "zh-CN-YunxiNeural", "duration": 24.875, "words": [[0.1, 0.537, "RAG"], [0.537, 0.762, "是"], [0.775, 0.975, "两"], [0.975, 1.163, "条"], [1.188, 1.738, "流水线"], [2.312, 2.625, "一条"], [2.65, 2.762, "是"], [2.775, 3.2, "离线"], [3.2, 3.488, "的"], [3.737, 3.938, "只"], [3.938, 4.05, "做"], [4.062, 4.55, "一次"], [4.812, 4.963, "把"], [4.975, 5.337, "文档"], [5.362, 5.675, "切成"], [5.675, 5.962, "块"], [6.3, 6.462, "把"], [6.475, 6.625, "每"], [6.625, 6.925, "一块"], [6.95, 7.188, "变成"], [7.2, 7.35, "一个"], [7.362, 7.812, "向量"], [8.037, 8.537, "存进"], [8.55, 8.9, "索引"], [9.475, 9.662, "另"], [9.662, 10.012, "一条"], [10.037, 10.137, "是"], [10.15, 10.325, "每"], [10.325, 10.4, "个"], [10.412, 10.675, "问题"], [10.7, 10.775, "都"], [10.775, 10.875, "要"], [10.887, 11.087, "走"], [11.088, 11.3, "的"], [11.625, 11.787, "把"], [11.8, 12.175, "问题"], [12.2, 12.438, "变成"], [12.45, 12.887, "向量"], [13.137, 13.537, "取回"], [13.562, 13.65, "离"], [13.65, 13.775, "它"], [13.787, 14.05, "最近"], [14.05, 14.138, "的"], [14.137, 14.462, "块"], [14.675, 14.913, "用"], [14.938, 15.137, "重"], [15.137, 15.45, "排模"], [15.45, 15.8, "型"], [15.9, 16.05, "把"], [16.062, 16.35, "最好"], [16.35, 16.425, "的"], [16.438, 16.55, "几"], [16.55, 16.688, "块"], [16.712, 17.05, "重新"], [17.062, 17.512, "排序"], [17.812, 18.175, "编好"], [18.175, 18.325, "号"], [18.325, 18.6, "放进"], [18.613, 19.038, "提示"], [19.25, 19.438, "让"], [19.45, 19.925, "模型"], [19.95, 20.1, "带"], [20.1, 20.175, "着"], [20.188, 20.438, "引用"], [20.45, 20.863, "作答"], [21.438, 21.75, "每个"], [21.762, 22.287, "环节"], [22.387, 22.712, "下面"], [22.725, 22.95, "写"], [22.95, 23.225, "着"], [23.325, 23.525, "这"], [23.525, 23.625, "一"], [23.625, 23.738, "步"], [23.762, 23.938, "可以"], [23.95, 24.175, "调"], [24.175, 24.25, "的"], [24.262, 24.625, "东西"]]}