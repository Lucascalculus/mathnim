{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "manim-web": ["../../../packages/manim-web/src/index.ts"],
      "manim-web/*": ["../../../packages/manim-web/src/*"],
      "@mathnim/core": ["../../../packages/core/src/index.ts"]
    }
  },
  "include": [".", "../functions", "../test"]
}
