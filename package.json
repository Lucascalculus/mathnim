{
  "name": "mathnim-monorepo",
  "private": true,
  "description": "Mathnim: an AI math tutor that explains with live, interactive Manim scenes in the browser.",
  "type": "module",
  "workspaces": [
    "packages/manim-web",
    "packages/core",
    "packages/present",
    "packages/visuals",
    "packages/ai",
    "apps/mathnim"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w mathnim",
    "build": "npm run build -w mathnim",
    "preview": "npm run preview -w mathnim",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "regress": "npm run regress -w manim-web",
    "doctor": "npm run doctor -w mathnim",
    "narration": "npm run narration -w mathnim",
    "deploy": "npm run build && cd apps/mathnim && wrangler pages deploy dist --project-name mathnim --branch main --commit-dirty=true"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.144.0"
  }
}
