{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mathnim-repo",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "apps/mathnim",
        "--port",
        "5176",
        "--strictPort"
      ],
      "port": 5176
    },
    {
      "name": "mathnim-admin",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ADMIN_EMAILS=admin@mathnim.test",
        "DATA_CENTRE=public",
        "node",
        "node_modules/vite/bin/vite.js",
        "apps/mathnim",
        "--port",
        "5178",
        "--strictPort"
