{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "manim-web": [
        "../manim-web/src/index.ts"
      ],
      "manim-web/*": [
        "../manim-web/src/*"
      ],
      "@mathnim/core": [
        "../core/src/index.ts"
      ],
      "@mathnim/present": [
        "../present/src/index.ts"
      ],
      "@mathnim/visuals": [
        "../visuals/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ]
}
